# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (MongoDB)
# ---------------------------------------------------------------------------
DBURL=mongodb://localhost:27017

# ---------------------------------------------------------------------------
# Auth (JWT + cookies)
# ---------------------------------------------------------------------------
# Long random string. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-secret
# Token lifetime (e.g. 7d, 12h, 30m). If you change it, sync cookie maxAge in src/utils/auth-token.ts
JWT_EXPIRES_IN=7d
# Frontend origin (used for CORS + links). On production set to the real site,
# e.g. https://studio.pnhd.ru — this also enables cross-site auth cookies.
FRONTEND_URL=http://localhost:3000
# Cookie Domain attribute. Leave empty so the cookie is scoped to the API host
# (pnhdstudioapi.ru). Do NOT set .pnhd.ru — that host is not a parent of the API.
# Optional: .pnhdstudioapi.ru if you need subdomain sharing on the API domain.
COOKIE_DOMAIN=
# Force SameSite=None; Secure (true) or SameSite=Lax (false). Leave unset to
# auto-detect from NODE_ENV / FRONTEND_URL.
# COOKIE_CROSS_SITE=true

# ---------------------------------------------------------------------------
# OTP (email one-time codes)
# ---------------------------------------------------------------------------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# Email (Yandex SMTP)
# ---------------------------------------------------------------------------
MAIL_LOGIN=noreply@pnhd.ru
MAIL_PASS=

# ---------------------------------------------------------------------------
# Stock webhook
# ---------------------------------------------------------------------------
STOCK_TOKEN=

# ---------------------------------------------------------------------------
# Payment
# ---------------------------------------------------------------------------
PAYMENT_AUTH=

# ---------------------------------------------------------------------------
# CDEK delivery
# ---------------------------------------------------------------------------
CDEK_AUTH_URL=
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_CREATE_ORDER=
CDEK_CALCULATE_DELIVERY=
CDEK_DELIVERY_POINTS_URL=
CDEK_CITIES_URL=

# ---------------------------------------------------------------------------
# Yandex (catalog / art)
# ---------------------------------------------------------------------------
YANDEX_CATALOG_ID=
YANDEX_ART=

# ---------------------------------------------------------------------------
# Yandex Object Storage (banners / CDN)
# ---------------------------------------------------------------------------
YANDEX_S3_ACCESS_KEY_ID=
YANDEX_S3_SECRET_ACCESS_KEY=
YANDEX_S3_BUCKET=
YANDEX_S3_ENDPOINT=https://storage.yandexcloud.net
YANDEX_S3_REGION=ru-central1
YANDEX_S3_BANNERS_PREFIX=banners
YANDEX_S3_BLOG_COVERS_PREFIX=blog-covers
YANDEX_S3_PRODUCT_PHOTOS_PREFIX=products
CDN_PUBLIC_URL=https://cdn.pnhd.ru
